  "export": {
    "arm": "quote",
    "required_completed_update": 100,
    "checkpoint_prefix": "@QUOTE_RUN@/adapter.epoch100",
    "model": "@EVALUATION_RUN@/exports/quote/jovovich.gguf",
    "steps": [
      {
        "id": "quote-endpoint-binding",
        "argv": [
          "python3",
          "-c",
          "import hashlib,json,sys\nfrom pathlib import Path\nrun=Path(sys.argv[1]); output=Path(sys.argv[2]); values=[]\nack=json.loads((run/'_units/completion.ack.json').read_text())\nassert ack['status']=='completed' and ack['archive_status']=='verified' and ack['acknowledged_updates']==100\nassert ack['remote_verification']['verified_remote_bytes'] is True\nsaved=json.loads((run/'_units/update-100.ack.json').read_text())\nassert saved['verified_remote_bytes'] is True and saved['unit_id']=='update-100'\nfinal_entries={r['name']:r for r in ack['remote_verification']['files']}\nsaved_entries={r['name']:r for r in saved['files']}\nfor part in ('gate','up','down'):\n for ext in ('f32','lora'):\n  final=f'adapter.{part}.{ext}'; epoch=f'adapter.epoch100.{part}.{ext}'\n  a=(run/final).read_bytes(); b=(run/epoch).read_bytes(); h=hashlib.sha256(a).hexdigest()\n  assert a==b and final_entries[final]['sha256']==h and saved_entries[epoch]['sha256']==h\n  assert final_entries[final]['size']==len(a) and saved_entries[epoch]['size']==len(a)\n  values.append(dict(final=final,epoch100=epoch,bytes=len(a),sha256=h))\nwith output.open('x') as f:json.dump(dict(update=100,status='pass',files=values,completion_revision=ack['remote_verification']['revision'],checkpoint_revision=saved['revision']),f,indent=2);f.write('\\n')\n",
          "@QUOTE_RUN@",
          "@EVALUATION_RUN@/exports/quote/endpoint-binding.json"
        ],
        "outputs": [
          "@EVALUATION_RUN@/exports/quote/endpoint-binding.json"
        ]
      },
      {
        "id": "quote-merge",
        "argv": [
          "build/jovovich-merge-mlp",
          "models/base-qwen.gguf",
          "@QUOTE_RUN@/adapter.epoch100",
          "@EVALUATION_RUN@/exports/quote/jovovich.gguf"
        ],
        "outputs": [
          "@EVALUATION_RUN@/exports/quote/jovovich.gguf"
        ]
      },
      {
        "id": "quote-byte-export-audit",
        "argv": [
          "python3",
          "training/results/2026-09-29-verdict-balance/verify_verdict_export.py",
          "models/base-qwen.gguf",
          "@EVALUATION_RUN@/exports/quote/jovovich.gguf",
          "@QUOTE_RUN@/adapter.epoch100",
          "@EVALUATION_RUN@/exports/quote/export-audit.json"
        ],
        "outputs": [
          "@EVALUATION_RUN@/exports/quote/export-audit.json"
        ]
      },
      {
        "id": "quote-native-export-parity",
        "argv": [
          "build/jovovich-probe-mlp",
          "models/base-qwen.gguf",
          "@EVALUATION_RUN@/exports/quote/jovovich.gguf",
          "@QUOTE_NATIVE@/quote.bin",
          "@QUOTE_RUN@/adapter.epoch100",
          "0",
          "1",
          "2",
          "3",
          "51"
        ],
        "stdout": "@EVALUATION_RUN@/exports/quote/parity.jsonl",
        "stderr": "@EVALUATION_RUN@/exports/quote/parity.stderr",
        "check_argv": [
          "python3",
          "-c",
          "import json,sys\nfrom pathlib import Path\nrows=[json.loads(line) for line in Path(sys.argv[1]).read_text().splitlines()]\nassert [row['row'] for row in rows]==[0,1,2,3,51]\nassert all(row['pass'] is True and row['argmax_agree']==row['completion_tokens'] and row['logits_relative_l2']<=1e-5 and row['residual_relative_l2']<=1e-5 and row['max_batch_ce_diff']<=1e-4 for row in rows)\nprint(json.dumps(dict(status='pass',rows=[row['row'] for row in rows],completion_tokens=sum(row['completion_tokens'] for row in rows))))\n",
          "@EVALUATION_RUN@/exports/quote/parity.jsonl"
        ],
        "outputs": [
          "@EVALUATION_RUN@/exports/quote/parity.jsonl",
          "@EVALUATION_RUN@/exports/quote/parity.stderr"
        ]
      }
    ]
  },
