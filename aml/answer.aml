# NoTorch supplies the measured choices. AML selects the answer and dates it.
assert(probabilities[0] >= 0 and probabilities[0] <= 1, "CONCERN probability")
assert(probabilities[1] >= 0 and probabilities[1] <= 1, "CLEAN probability")
assert(abs(probabilities[0] + probabilities[1] - 1) < 0.000001, "probability sum")
verdict = "CLEAN"
if probabilities[0] >= probabilities[1]:
    verdict = "CONCERN"
reviewed_at = calendar_instant(clock_parts[0], clock_parts[1], clock_parts[2])
