# The host supplies observed file checks in Git order along the selected history.
# Stream keys identify the same AML rule, routing policy and renderer.
samples = map_new()
conflicts = map_new()
size = list_len(history_heads)
i = 0
while i < size:
    key = text_concat(list_get(history_streams, i), list_get(history_heads, i))
    if history_outcomes[i] > 0:
        if map_has(samples, key):
            j = map_get(samples, key)
            if history_outcomes[i] != history_outcomes[j] or text_equal(list_get(history_outputs, i), list_get(history_outputs, j)) == 0:
                map_set(conflicts, key, 1)
        map_set(samples, key, i)
    i = i + 1

# Reverse order makes the closest later match available at each mismatch.
nearest = map_new()
recoveries = list_new()
states = list_new()
i = size - 1
while i >= 0:
    stream = list_get(history_streams, i)
    head = list_get(history_heads, i)
    key = text_concat(stream, head)
    recovery = ""
    state = "skipped"
    if history_outcomes[i] == 1:
        state = "met"
        if map_has(conflicts, key) == 0:
            map_set(nearest, stream, i)
    if history_outcomes[i] == 2:
        state = "mismatch"
        if map_has(nearest, stream):
            recovery = list_get(history_heads, map_get(nearest, stream))
    if history_outcomes[i] > 0 and map_has(conflicts, key):
        state = "conflicting"
    list_push(recoveries, recovery)
    list_push(states, state)
    i = i - 1
