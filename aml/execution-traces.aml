# Both input modes and their requirements come from the domain oracle.
rule = text_concat(api, "(mode) accepts mode 0 or 1. ")
metric = "callback sequence"
if trace_config[0] == 1:
    metric = text_concat("number of calls to ", target)
rule = text_concat(rule, "When mode = 0, the required ")
rule = text_concat(rule, metric)
rule = text_concat(rule, " is ")
rule = text_concat(rule, required_zero)
rule = text_concat(rule, ". When mode = 1, the required ")
rule = text_concat(rule, metric)
rule = text_concat(rule, " is ")
rule = text_concat(rule, required_one)
rule = text_concat(rule, ".")
review_context = text_concat("File: ", file)
review_context = text_concat(review_context, "\nRepository requirement: ")
review_context = text_concat(review_context, rule)
review_context = text_concat(review_context, "\nProposed complete function:\n```c\n")
review_context = text_concat(review_context, source_code)
review_context = text_concat(review_context, "\n```")
if trace_config[1] > 0:
    review_context = text_concat(review_context, "\nExecution at mode = ")
    review_context = text_concat(review_context, mode_text)
    review_context = text_concat(review_context, ".")
    if trace_config[1] != 2:
        review_context = text_concat(review_context, " Required ")
        review_context = text_concat(review_context, metric)
        review_context = text_concat(review_context, " = ")
        review_context = text_concat(review_context, required_value)
        review_context = text_concat(review_context, ".")
    review_context = text_concat(review_context, " Observed ")
    review_context = text_concat(review_context, metric)
    review_context = text_concat(review_context, " = ")
    review_context = text_concat(review_context, observed_value)
    review_context = text_concat(review_context, ".")
